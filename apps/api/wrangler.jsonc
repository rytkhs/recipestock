{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recipestock",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "RECIPE_IMAGES",
      "bucket_name": "recipestock-images-dev",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMPORT_QUEUE",
        "queue": "recipestock-import-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "recipestock-import-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "recipestock-import-jobs-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "SHORTCUT_RATE_LIMITER",
      "namespace_id": "79",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // 認証前に引く安全弁。正常利用は1 credentialあたり最大10/minなので、
      // NAT配下に重いユーザーが数人いても収まり、単一送信元のtoken照合は頭打ちになる。
      "name": "SHORTCUT_CLIENT_RATE_LIMITER",
      "namespace_id": "80",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1_ytdlp_metadata_container",
      "new_sqlite_classes": ["YtDlpMetadataContainer"]
    },
    {
      "tag": "v2_delete_ytdlp_metadata_container",
      "deleted_classes": ["YtDlpMetadataContainer"]
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  }
}
